{
  "$description": "Karpos design tokens, W3C Design Tokens Community Group draft format",
  "color": {
    "karpos": {
      "leaf":         { "$value": "#0E5C3A", "$type": "color" },
      "leaf-hover":   { "$value": "#0A4A2E", "$type": "color" },
      "sprout":       { "$value": "#3FA66B", "$type": "color" },
      "bark":         { "$value": "#3B2A1F", "$type": "color" },
      "clay":         { "$value": "#C0653B", "$type": "color" },
      "amber":        { "$value": "#F0B23C", "$type": "color" },
      "cream":        { "$value": "#FAF7F2", "$type": "color" },
      "fog":          { "$value": "#ECECE8", "$type": "color" },
      "slate":        { "$value": "#1B2A29", "$type": "color" }
    },
    "semantic": {
      "success":      { "$value": "#2E7D4F", "$type": "color" },
      "warning":      { "$value": "#E89A2C", "$type": "color" },
      "danger":       { "$value": "#B53A2E", "$type": "color" },
      "info":         { "$value": "#2B6FA6", "$type": "color" }
    },
    "surface": {
      "base":         { "$value": "{color.karpos.cream}", "$type": "color" },
      "raised":       { "$value": "#FFFFFF",              "$type": "color" },
      "sunken":       { "$value": "{color.karpos.fog}",   "$type": "color" },
      "inverse":      { "$value": "{color.karpos.slate}", "$type": "color" }
    },
    "text": {
      "primary":      { "$value": "{color.karpos.bark}",  "$type": "color" },
      "secondary":    { "$value": "#5A4A3F",              "$type": "color" },
      "muted":        { "$value": "#8A7A70",              "$type": "color" },
      "inverse":      { "$value": "{color.karpos.cream}", "$type": "color" },
      "link":         { "$value": "{color.karpos.leaf}",  "$type": "color" }
    }
  },
  "font": {
    "family": {
      "display":      { "$value": ["Fraunces", "Georgia", "serif"],            "$type": "fontFamily" },
      "ui":           { "$value": ["Inter", "system-ui", "sans-serif"],        "$type": "fontFamily" },
      "mono":         { "$value": ["JetBrains Mono", "Menlo", "monospace"],    "$type": "fontFamily" }
    },
    "weight": {
      "regular":      { "$value": 400, "$type": "fontWeight" },
      "medium":       { "$value": 500, "$type": "fontWeight" },
      "semibold":     { "$value": 600, "$type": "fontWeight" },
      "bold":         { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "xs":           { "$value": "12px", "$type": "dimension" },
      "sm":           { "$value": "14px", "$type": "dimension" },
      "md":           { "$value": "16px", "$type": "dimension" },
      "lg":           { "$value": "20px", "$type": "dimension" },
      "xl":           { "$value": "24px", "$type": "dimension" },
      "2xl":          { "$value": "30px", "$type": "dimension" },
      "3xl":          { "$value": "38px", "$type": "dimension" },
      "4xl":          { "$value": "48px", "$type": "dimension" }
    }
  },
  "space": {
    "0":  { "$value": "0px",   "$type": "dimension" },
    "1":  { "$value": "4px",   "$type": "dimension" },
    "2":  { "$value": "8px",   "$type": "dimension" },
    "3":  { "$value": "12px",  "$type": "dimension" },
    "4":  { "$value": "16px",  "$type": "dimension" },
    "5":  { "$value": "20px",  "$type": "dimension" },
    "6":  { "$value": "24px",  "$type": "dimension" },
    "8":  { "$value": "32px",  "$type": "dimension" },
    "10": { "$value": "40px",  "$type": "dimension" },
    "12": { "$value": "48px",  "$type": "dimension" },
    "16": { "$value": "64px",  "$type": "dimension" },
    "24": { "$value": "96px",  "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0px",  "$type": "dimension" },
    "sm":   { "$value": "4px",  "$type": "dimension" },
    "md":   { "$value": "8px",  "$type": "dimension" },
    "lg":   { "$value": "12px", "$type": "dimension" },
    "xl":   { "$value": "16px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "sm":   { "$value": "0 1px 2px rgba(27,42,41,0.08)",                       "$type": "shadow" },
    "md":   { "$value": "0 4px 8px rgba(27,42,41,0.10), 0 1px 2px rgba(27,42,41,0.06)", "$type": "shadow" },
    "lg":   { "$value": "0 12px 24px rgba(27,42,41,0.12)",                     "$type": "shadow" }
  },
  "duration": {
    "fast":   { "$value": "120ms", "$type": "duration" },
    "normal": { "$value": "200ms", "$type": "duration" },
    "slow":   { "$value": "320ms", "$type": "duration" }
  }
}
