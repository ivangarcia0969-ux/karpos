# Karpos VPS production env — copy to /opt/karpos/.env and fill secrets.
# install.sh genera valores aleatorios para las contraseñas y deja el resto pendiente.

PUBLIC_HOST=cultivarapp.karpos.surcoapp.tech
KARPOS_TAG=latest

# Internal service passwords (genéralos con: openssl rand -base64 24)
POSTGRES_DB=karpos
POSTGRES_USER=karpos
POSTGRES_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
S3_ACCESS_KEY=karpos
S3_SECRET_KEY=__GENERATE__
ML_API_KEY=__GENERATE__

# OIDC (Keycloak). Para arrancar sin Keycloak deja todo placeholder; el JWT guard rechazará llamadas
# pero el portal QR público (/portal/*) y el copiloto vía Ollama siguen sirviendo.
# Cuando agregues Keycloak, apuntá OIDC_ISSUER al realm correspondiente.
OIDC_ISSUER=https://cultivarapp.karpos.surcoapp.tech/realms/karpos
OIDC_CLIENT_ID=karpos-web
OIDC_CLIENT_SECRET=__SET_AFTER_KEYCLOAK__

# Karpos IQ — Ollama (ya lo tienes corriendo en 127.0.0.1:11434 del host).
OLLAMA_MODEL=llama3.1

# Opcionales
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
