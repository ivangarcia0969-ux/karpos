{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "verbatimModuleSyntax": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@karpos/types": ["packages/types/src/index.ts"],
      "@karpos/types/*": ["packages/types/src/*"],
      "@karpos/sdk": ["packages/sdk/src/index.ts"],
      "@karpos/sdk/*": ["packages/sdk/src/*"],
      "@karpos/ui": ["packages/ui/src/index.ts"],
      "@karpos/ui/*": ["packages/ui/src/*"],
      "@karpos/i18n": ["packages/i18n/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "build", "coverage"]
}
