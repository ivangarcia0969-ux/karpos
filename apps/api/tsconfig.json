{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "sourceMap": true,
    "lib": ["ES2022"],
    "jsx": "preserve"
  },
  "include": ["src/**/*", "test/**/*"]
}
